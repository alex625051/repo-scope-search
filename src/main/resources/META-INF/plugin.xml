<idea-plugin url="https://github.com/alex625051/repo-scope-search">
    <id>dev.alexananev.repo-scope-search</id>
    <name>Repo Scope Search</name>
    <vendor>Alex Ananev</vendor>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.python</depends>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Repo Scope Search"
                    anchor="bottom"
                    factoryClass="dev.alexananev.reposcopesearch.ui.RepoSearchToolWindowFactory"
                    canCloseContents="false"/>
    </extensions>
</idea-plugin>
